{
  "name": "fablethread",
  "version": "0.2.0",
  "private": true,
  "description": "A local writing studio for connected stories.",
  "author": "Gabriel",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "node scripts/make-icon.mjs && tsc -b && vite build",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.fablethread.studio",
    "productName": "Fablethread",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "public/brand.png"
    ],
    "win": {
      "icon": "public/app.ico",
      "artifactName": "Fablethread-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "Fablethread-Portable-${version}.${ext}"
    }
  }
}
